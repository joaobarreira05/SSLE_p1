{
  "uid": "ssle-soc",
  "title": "SSLE — SOC (visão global)",
  "description": "Vista do SOC no core/obs: só agregados federados dos sites (R5) + incidentes do correlator.",
  "tags": [
    "ssle",
    "soc",
    "fcaps"
  ],
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timezone": "browser",
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "geomap",
      "title": "Sites — disponibilidade",
      "description": "Posição de cada site (lat/lon do inventário, servida pelo reg-01 como site_info) e a fração de elementos 'up'. Sem Internet no lab o mapa de fundo não carrega; os marcadores sim.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 10,
        "h": 11
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom-global"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-global"
          },
          "expr": "site:info:last",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-global"
          },
          "expr": "site:up:ratio",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "view": {
          "id": "coords",
          "lat": 39.9,
          "lon": -8.6,
          "zoom": 6.4
        },
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": true
        },
        "basemap": {
          "type": "xyz",
          "name": "OpenStreetMap",
          "config": {
            "url": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
            "attribution": "© OpenStreetMap"
          }
        },
        "tooltip": {
          "mode": "details"
        },
        "layers": [
          {
            "type": "markers",
            "name": "Sites",
            "tooltip": true,
            "location": {
              "mode": "coords",
              "latitude": "lat",
              "longitude": "lon"
            },
            "config": {
              "showLegend": true,
              "style": {
                "size": {
                  "fixed": 14
                },
                "color": {
                  "field": "Value #B",
                  "fixed": "green"
                },
                "text": {
                  "mode": "field",
                  "field": "site",
                  "fixed": ""
                },
                "textConfig": {
                  "fontSize": 13,
                  "offsetY": -18,
                  "textAlign": "center",
                  "textBaseline": "middle"
                }
              }
            }
          }
        ]
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "site",
            "mode": "outer"
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "fields": {},
            "conversions": [
              {
                "targetField": "lat",
                "destinationType": "number"
              },
              {
                "targetField": "lon",
                "destinationType": "number"
              }
            ]
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Disponibilidade por site",
      "description": "site:up:ratio — média de up{job=\"node\"} no site (recording rule federada).",
      "gridPos": {
        "x": 10,
        "y": 0,
        "w": 8,
        "h": 5
