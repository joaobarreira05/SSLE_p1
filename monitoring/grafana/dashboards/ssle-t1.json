{
  "uid": "ssle-t1",
  "title": "SSLE — T1 DoS (ing-01)",
  "description": "Threat 1: request rate on ing-01 (avr), latency as seen by the server and the CLIENT (opo sensors) against the 100 ms SLO, and rule state. See threats/t1-ddos/post-mortem.md.",
  "tags": [
    "ssle",
    "t1",
    "dos"
  ],
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timezone": "browser",
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate on ing-01 (R of RED)",
      "description": "Input to TrafficAnomaly (robust z-score: median + IQR of the last hour).",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom-avr"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-avr"
          },
          "expr": "instance:http_requests:rate1m{instance_name=\"ing-01\"}",
          "legendFormat": "ing-01 (req/s)",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Robust z-score of TrafficAnomaly (threshold 3)",
      "description": "Same expression as the rule (monitoring/site/rules/anomalies.yml). Log scale; below 0.1 is resting noise.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom-avr"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-avr"
          },
          "expr": "abs(instance:http_requests:rate1m{instance_name=\"ing-01\"} - quantile_over_time(0.5, instance:http_requests:rate1m{instance_name=\"ing-01\"}[1h])) / clamp_min((quantile_over_time(0.75, instance:http_requests:rate1m{instance_name=\"ing-01\"}[1h]) - quantile_over_time(0.25, instance:http_requests:rate1m{instance_name=\"ing-01\"}[1h])) / 1.349, 0.5)",
          "legendFormat": "robust z",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "thresholdsStyle": {
              "mode": "dashed"
            },
            "scaleDistribution": {
              "type": "log",
              "log": 10
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "min": 0.01
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "p95 latency — server vs client (SLO 100 ms)",
      "description": "The T1 lesson: the server measures ~23 ms while the client feels ~242 ms (the queue before Flask starts serving). Hence the SLO must be measured on the client side (ClientLatencySLO).",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-avr"
          },
          "expr": "instance:http_request_duration_seconds:p95_1m{instance_name=\"ing-01\"}",
          "legendFormat": "server (ing-01, measured in Flask)",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-opo"
          },
          "expr": "instance:ssle_sensor_upstream_duration_seconds:p95_1m{role=\"sensor\"}",
          "legendFormat": "client ({{instance_name}})",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 3
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "client (sen-02)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Rule state (1 = pending · 2 = firing)",
      "description": "MTTD = instant it switches to firing − stimulus start (for: 1m after the 1st signal).",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-avr"
          },
          "expr": "max by (alertname, instance_name) (ALERTS{alertname=~\"TrafficAnomaly|ServiceLatencyHigh\",alertstate=\"firing\"}) * 2 or max by (alertname, instance_name) (ALERTS{alertname=~\"TrafficAnomaly|ServiceLatencyHigh\",alertstate=\"pending\"})",
          "legendFormat": "{{alertname}} · {{instance_name}}",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-opo"
          },
          "expr": "max by (alertname, instance_name) (ALERTS{alertname=~\"ClientLatencySLO|ClientUpstreamErrors\",alertstate=\"firing\"}) * 2 or max by (alertname, instance_name) (ALERTS{alertname=~\"ClientLatencySLO|ClientUpstreamErrors\",alertstate=\"pending\"})",
          "legendFormat": "{{alertname}} · {{instance_name}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 35,
            "gradientMode": "scheme",
            "spanNulls": false,
            "axisLabel": "state"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "red",
                "value": 1.5
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "pending",
                  "index": 0
                },
                "2": {
                  "text": "firing",
                  "index": 1
                }
              }
            }
          ],
          "min": 0,
          "max": 2.2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Sensor readings (ok / error)",
      "description": "Collateral damage: lost readings (timeout 5 s) during the attack and during the response.",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom-opo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-opo"
          },
          "expr": "sum by (result) (rate(ssle_sensor_readings_total{role=\"sensor\"}[1m]))",
          "legendFormat": "{{result}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          },
          "unit": "reqps"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "error"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ok"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Served latency — distribution (ing-01 p95 vs SLO)",
      "description": "Even during the attack, the server 'thinks' it is fast: queue time is not included here.",
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom-avr"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-avr"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_request_duration_seconds_bucket{instance_name=\"ing-01\"}[1m])))",
          "legendFormat": "p50",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-avr"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{instance_name=\"ing-01\"}[1m])))",
          "legendFormat": "p99",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
