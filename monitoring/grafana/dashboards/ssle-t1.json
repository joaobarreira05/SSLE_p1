{
  "uid": "ssle-t1",
  "title": "SSLE — T1 DoS (ing-01)",
  "description": "Ameaça 1: taxa no ing-01 (avr), latência vista pelo servidor e pelo CLIENTE (sensores de opo) contra o SLO de 100 ms, e o estado das regras. Ver threats/t1-ddos/post-mortem.md.",
  "tags": [
    "ssle",
    "t1",
    "dos"
  ],
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timezone": "browser",
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Taxa de pedidos no ing-01 (R de RED)",
      "description": "Entrada do TrafficAnomaly (z-score robusto: mediana + IQR da última hora).",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom-avr"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-avr"
          },
          "expr": "instance:http_requests:rate1m{instance_name=\"ing-01\"}",
          "legendFormat": "ing-01 (pedidos/s)",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "z robusto do TrafficAnomaly (limiar 3)",
      "description": "A mesma expressão da regra (monitoring/site/rules/anomalies.yml). Escala log; abaixo de 0,1 é ruído de repouso.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom-avr"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-avr"
          },
          "expr": "abs(instance:http_requests:rate1m{instance_name=\"ing-01\"} - quantile_over_time(0.5, instance:http_requests:rate1m{instance_name=\"ing-01\"}[1h])) / clamp_min((quantile_over_time(0.75, instance:http_requests:rate1m{instance_name=\"ing-01\"}[1h]) - quantile_over_time(0.25, instance:http_requests:rate1m{instance_name=\"ing-01\"}[1h])) / 1.349, 0.5)",
          "legendFormat": "z robusto",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "thresholdsStyle": {
              "mode": "dashed"
            },
            "scaleDistribution": {
              "type": "log",
              "log": 10
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "min": 0.01
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latência p95 — servidor vs cliente (SLO 100 ms)",
      "description": "A lição da T1: o servidor mede ~23 ms enquanto o cliente sente ~242 ms (a fila antes de o Flask atender). Por isso o SLO tem de ser medido do lado do cliente (ClientLatencySLO).",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-avr"
          },
          "expr": "instance:http_request_duration_seconds:p95_1m{instance_name=\"ing-01\"}",
          "legendFormat": "servidor (ing-01, medido no Flask)",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-opo"
          },
          "expr": "instance:ssle_sensor_upstream_duration_seconds:p95_1m{role=\"sensor\"}",
          "legendFormat": "cliente ({{instance_name}})",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 3
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Estado das regras (1 = pending · 2 = firing)",
      "description": "MTTD = instante em que passa a firing − início do estímulo (for: 1m depois do 1.º sinal).",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-avr"
          },
          "expr": "max by (alertname, instance_name) (ALERTS{alertname=~\"TrafficAnomaly|ServiceLatencyHigh\",alertstate=\"firing\"}) * 2 or max by (alertname, instance_name) (ALERTS{alertname=~\"TrafficAnomaly|ServiceLatencyHigh\",alertstate=\"pending\"})",
          "legendFormat": "{{alertname}} · {{instance_name}}",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-opo"
          },
          "expr": "max by (alertname, instance_name) (ALERTS{alertname=~\"ClientLatencySLO|ClientUpstreamErrors\",alertstate=\"firing\"}) * 2 or max by (alertname, instance_name) (ALERTS{alertname=~\"ClientLatencySLO|ClientUpstreamErrors\",alertstate=\"pending\"})",
          "legendFormat": "{{alertname}} · {{instance_name}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 35,
            "gradientMode": "scheme",
            "spanNulls": false,
            "axisLabel": "estado"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "red",
                "value": 1.5
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "pending",
                  "index": 0
                },
                "2": {
                  "text": "firing",
                  "index": 1
                }
              }
            }
          ],
          "min": 0,
          "max": 2.2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Leituras dos sensores (ok / erro)",
      "description": "Dano colateral: leituras perdidas (timeout 5 s) durante o ataque e durante a resposta.",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom-opo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-opo"
          },
          "expr": "sum by (result) (rate(ssle_sensor_readings_total{role=\"sensor\"}[1m]))",
          "legendFormat": "{{result}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          },
          "unit": "reqps"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "error"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ok"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Latência servida — distribuição (p95 do ing-01 vs SLO)",
      "description": "Mesmo durante o ataque, o servidor 'acha' que está rápido: o tempo de fila não entra aqui.",
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom-avr"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-avr"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_request_duration_seconds_bucket{instance_name=\"ing-01\"}[1m])))",
          "legendFormat": "p50",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-avr"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{instance_name=\"ing-01\"}[1m])))",
          "legendFormat": "p99",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
