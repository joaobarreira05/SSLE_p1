# SITE Prometheus (apt, 2.53.x). Rendered by infra/deploy.sh:
#   @@SITE@@         -> site code (avr, opo, ...)
#   @@ALERTMANAGER@@ -> address of the central Alertmanager (obs leg on this network)
#   @@REGISTRY@@     -> the site's reg-01 (ip:5050); without reg-01 the deploy removes the ">>> registry" block
global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    region: pt
    site: @@SITE@@
    level: site
rule_files:
  - /etc/prometheus/rules/*.yml
alerting:
  alertmanagers:
    - static_configs:
        - targets: ['@@ALERTMANAGER@@']
scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ['localhost:9090']
  - job_name: node
    file_sd_configs:
      - files: ['/etc/prometheus/targets/node.json']
  - job_name: services
    metrics_path: /metrics
    file_sd_configs:
      - files: ['/etc/prometheus/targets/flask.json']
  # >>> registry
  # Elements that REGISTER with the site's reg-01 (lease with TTL, registry/core.py). Inventory elements
  # stay in the file_sd above: if the registry fails, the base fleet stays monitored and HTTP SD keeps
  # the last targets it knew. The relabel sets the SAME job as the rules (up{job="node"}, …),
  # so liveness, aggregates and alerts apply to dynamic elements without changing a line.
  - job_name: node-registry
    http_sd_configs:
      - url: http://@@REGISTRY@@/sd/node
        refresh_interval: 15s
    relabel_configs:
      - target_label: job
        replacement: node
  - job_name: services-registry
    http_sd_configs:
      - url: http://@@REGISTRY@@/sd/services
        refresh_interval: 15s
    relabel_configs:
      - target_label: job
        replacement: services
  - job_name: registry
    static_configs:
      - targets: ['@@REGISTRY@@']
  # <<< registry
