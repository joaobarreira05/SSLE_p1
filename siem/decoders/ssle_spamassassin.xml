<!--
  SpamAssassin (spamd) → fields for the 1103xx rules. Validated on wazuh-analysisd 4.14.10
  (bash siem/tests/run-logtest.sh). spamd writes TWO lines per message (lecture 8 §5):

    spamd[1234]: spamd: identified spam (6.2/5.0) for debian-spamd:109 in 0.3 seconds, 547 bytes.
    spamd[1234]: spamd: result: Y 6 - ALL_TRUSTED,DRUGS_ERECTILE scantime=0.3,size=547,…,required_score=5.0,…

  · "result:"  → verdict (Y = spam, "." = ham), INTEGER score ("%2d": "Y  6", "Y 1000", ".  0", ". -1"),
                 list of tests and the required_score;
  · "identified spam / clean message" → score with decimals and threshold (what goes in the report).
  The previous version looked for "score=… required=…", which spamd does not write: it never extracted anything.
  PCRE2 because OS_Regex has no optional groups and no negative sign.
-->
<decoder name="spamassassin">
  <program_name>spamd</program_name>
</decoder>

<decoder name="spamassassin-result">
  <parent>spamassassin</parent>
  <prematch>^spamd: result: </prematch>
  <regex type="pcre2">^spamd: result: (\S) +(-?\d+) - (\S+) .*required_score=([\d.]+)</regex>
  <order>sa_flag, sa_score, sa_tests, sa_required</order>
</decoder>

<decoder name="spamassassin-verdict">
  <parent>spamassassin</parent>
  <prematch>^spamd: identified spam |^spamd: clean message </prematch>
  <regex type="pcre2">^spamd: (identified spam|clean message) \((-?[\d.]+)/([\d.]+)\) for (\S+?):\d+ </regex>
  <order>sa_verdict, sa_score, sa_required, dstuser</order>
</decoder>
